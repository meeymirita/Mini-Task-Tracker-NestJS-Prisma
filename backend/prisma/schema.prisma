generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      Status   @default(todo)
  priority    Priority @default(low)
  createdAt   DateTime @default(now())
}
// Дефолт назначана
enum Status {
  // Названачана
  todo
  // В процессе
  in_progress
  // Выполнена
  done
}
// Дефолт низкий
enum Priority {
  // низкий
  low
  // средний
  medium
  // высокий
  high
}
